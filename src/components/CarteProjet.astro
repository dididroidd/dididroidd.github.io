---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';
import { STATUTS } from '../lib/statut';

interface Props {
  projet: CollectionEntry<'projets'>;
}

const { projet } = Astro.props;
const { titre, resume, statut, technos } = projet.data;
---

<a class="carte-projet" href={url(`/projets/${projet.id}/`)}>
  <h3>{titre}</h3>
  <p>{resume}</p>
  <p class="meta">
    <span class:list={['statut', `statut--${statut}`]}>{STATUTS[statut]}</span>
    {technos.length > 0 && <span> · {technos.join(', ')}</span>}
  </p>
</a>
