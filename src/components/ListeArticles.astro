---
import { formatDate } from '../lib/date';

interface Props {
  articles: { href: string; titre: string; date: Date; resume?: string }[];
  vide?: string;
}

const { articles, vide = "Pas encore d'entrée." } = Astro.props;
---

{
  articles.length === 0 ? (
    <p class="vide">{vide}</p>
  ) : (
    <ul class="liste-articles">
      {articles.map((a) => (
        <li>
          <time datetime={a.date.toISOString().slice(0, 10)}>{formatDate(a.date)}</time>
          <a href={a.href}>{a.titre}</a>
          {a.resume && <p>{a.resume}</p>}
        </li>
      ))}
    </ul>
  )
}
