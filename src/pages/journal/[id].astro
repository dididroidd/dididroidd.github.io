---
import { render, type CollectionEntry } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { journalPublie } from '../../lib/journal';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  return (await journalPublie()).map(({ entree, projet }) => ({ params: { id: entree.id }, props: { entree, projet } }));
}

interface Props {
  entree: CollectionEntry<'journal'>;
  projet: CollectionEntry<'projets'>;
}

const { entree, projet } = Astro.props;
const { Content } = await render(entree);
---

<Article titre={entree.data.titre} date={entree.data.date} type="journal" projet={projet.data.titre}>
  <Content />
  <p slot="apres" class="retour"><a href={url(`/projets/${projet.id}/`)}>← {projet.data.titre}</a></p>
</Article>
