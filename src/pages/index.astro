---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { byDateDesc, isPublished } from '../lib/contenu';
import { formatDateCourte } from '../lib/date';
import { journalPublie } from '../lib/journal';
import { TYPES_JOURNAL, idCourt } from '../lib/journal-format';
import { projetsPublies } from '../lib/projets';
import { ACCROCHE, INTRO } from '../lib/site';
import { STATUTS } from '../lib/statut';
import { url } from '../lib/url';

const projets = await projetsPublies();
const journal = (await journalPublie()).sort((a, b) => byDateDesc(a.entree, b.entree));
const revues = (await getCollection('revues', isPublished)).sort(byDateDesc).slice(0, 2);

const parProjet = (id: string) => journal.filter((j) => j.projet.id === id).map((j) => j.entree);
---

<Base section="accueil">
  <h1 class="accroche" set:html={ACCROCHE} />
  <p class="intro">{INTRO}</p>

  <div class="surtitre statut--en-cours" style="margin-bottom:6px">Projets</div>
  <h2 class="titre-section">Ce que je fabrique</h2>
  <ul class="liste-projets">
    {
      projets.map((p) => {
        const entrees = parProjet(p.id);
        const maj = entrees[0]?.data.date ?? p.data.depuis;
        const s = STATUTS[p.data.statut];
        return (
          <li>
            <div class="ligne">
              <a class="nom-projet" href={url(`/projets/${p.id}/`)}>
                {p.data.titre}
              </a>
              <span class:list={['statut', `statut--${p.data.statut}`]}>
                {s.symbole} {s.label}
              </span>
              <span class="discret">
                · {entrees.length} {entrees.length > 1 ? 'entrées' : 'entrée'} · {formatDateCourte(maj)}
              </span>
            </div>
            <div class="resume">{p.data.resume}</div>
          </li>
        );
      })
    }
  </ul>

  {
    journal.length > 0 && (
      <>
        <div class="surtitre">Dernières entrées du journal</div>
        <div class="recents">
          {journal.slice(0, 3).map(({ entree }) => {
            const t = TYPES_JOURNAL[entree.data.type];
            return (
              <div class="recent">
                <span class:list={['symbole', `t-${entree.data.type}`]}>{t.symbole}</span>
                <span class="id-court">{idCourt(entree.id)}</span>
                <span>
                  <a href={url(`/journal/${entree.id}/`)}>{entree.data.titre}</a>{' '}
                  <span class:list={['discret', `t-${entree.data.type}`]}>#{t.tag}</span>
                </span>
              </div>
            );
          })}
        </div>
      </>
    )
  }

  <section class="encart-revue">
    <div class="tete">
      <span>La revue tech, le dimanche</span>
      <a href={url('/revues/')}>toutes →</a>
    </div>
    {
      revues.length === 0 ? (
        <p class="vide">Pas encore de revue.</p>
      ) : (
        revues.map((r) => (
          <div class="item">
            <span class="statut" style="color:var(--bleu);padding-top:3px">
              N°{r.data.numero}
            </span>
            <a href={url(`/revues/${r.id}/`)}>{r.data.titre}</a>
          </div>
        ))
      )
    }
  </section>
</Base>
