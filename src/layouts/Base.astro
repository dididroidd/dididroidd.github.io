---
import '../styles/global.css';
import { url } from '../lib/url';
import { DESCRIPTION_SITE, NOM_SITE } from '../lib/site';

interface Props {
  titre?: string;
  description?: string;
}

const { titre, description = DESCRIPTION_SITE } = Astro.props;
const titreComplet = titre ? `${titre} · ${NOM_SITE}` : NOM_SITE;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={NOM_SITE} href={new URL(url('/rss.xml'), Astro.site)} />
    <title>{titreComplet}</title>
  </head>
  <body>
    <header class="entete">
      <a class="logo" href={url('/')}>{NOM_SITE}</a>
      <nav>
        <a href={url('/projets/')}>Projets</a>
        <a href={url('/revues/')}>Revue tech</a>
        <a href={url('/a-propos/')}>À propos</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="pied">
      <p>{NOM_SITE} · {new Date().getFullYear()}</p>
    </footer>
  </body>
</html>
